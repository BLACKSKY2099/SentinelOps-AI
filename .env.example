# SentinelOps-AI Environment Configuration Example
# Copy this file to .env for local development.
# NEVER commit .env files containing actual secrets or credentials to git.

# AWS Credentials (optional for local mock; required for CloudWatch & Bedrock live access)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Settings
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# GitHub Integration (Fine-grained Personal Access Token with repo read/write scopes)
GITHUB_TOKEN=

# Control Plane API Configuration
SENTINELOPS_API_HOST=0.0.0.0
SENTINELOPS_API_PORT=8000
